# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=4000

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Storage locations (relative to the repo root)
DATA_DIR=server/data
UPLOAD_DIR=server/uploads
MAX_UPLOAD_MB=512

# Comma-separated origins allowed to call the API with credentials
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Used only by `npm run seed` to create the first admin
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@codingmindset.dev
ADMIN_PASSWORD=ChangeMe123!
